# Claude API key used by the /api routes (server side only, never sent to the tablet).
ANTHROPIC_API_KEY=
# Optional: override the model.
# DADI_MODEL=claude-opus-5-5

# Optional: a natural, lively voice (Azure Speech, free tier is plenty). Without these the tablet's own voices are used.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# DADI_VOICE_EN=en-IN-NeerjaNeural
# DADI_VOICE_HI=hi-IN-SwaraNeural
